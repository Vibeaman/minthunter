# Telegram Bot Token
BOT_TOKEN=your_telegram_bot_token

# Ethereum mainnet RPC (at least one configured endpoint is required)
ALCHEMY_RPC=https://eth-mainnet.g.alchemy.com/v2/your_key
INFURA_RPC=
QUICKNODE_RPC=
# Optional comma-separated additional trusted RPC endpoints
BROADCAST_RPCS=
# Optional configured Flashbots endpoint
FLASHBOTS_RPC=
# Etherscan API key for verified ABI analysis
ETHERSCAN_API_KEY=

# Fee wallet receives FCFS fees after a confirmed successful mint
FEE_WALLET=0x0000000000000000000000000000000000000000

# Fee amount in ETH
FCFS_FEE_ETH=0.0002

# Optional SimpleHash API key for floor-price fallback
SIMPLEHASH_API_KEY=

# 32-byte hex key for AES-256 encryption (64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_key_here
